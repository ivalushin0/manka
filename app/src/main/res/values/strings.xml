    <!-- settings -->
    <string name="settings_bypass">Bypass</string>
    <string name="block_quic">Block QUIC (UDP 443)</string>
    <string name="block_quic_hint">Apps fall back to TCP, which the strategies handle best. Recommended.</string>
    <string name="ipv6">IPv6</string>
    <string name="ipv6_hint">Apply the bypass to IPv6 traffic too</string>
    <string name="dns_title">DNS</string>
    <string name="dns_hint">Where DNS requests go while bypass is on. The ISP DNS often answers blocked sites (Instagram, etc.) with a stub or nothing, and some ISPs do the same to plain DNS sent to public servers — then no strategy helps. Google / Cloudflare / Quad9 are encrypted (DNS-over-HTTPS), the ISP cannot see or alter them. A custom server below is plain DNS.</string>
    <string name="dns_system">System</string>
    <string name="dns_google">Google</string>
    <string name="dns_cloudflare">Cloudflare</string>
    <string name="dns_quad9">Quad9</string>
    <string name="dns_custom">Custom DNS server (IPv4, unencrypted)</string>
    <string name="exclude_sites">Excluded sites</string>
    <string name="exclude_sites_hint">zapret does not touch these domains (and their subdomains). One per line.</string>
    <string name="tcp_ports">zapret TCP ports</string>
    <string name="udp_ports">zapret UDP ports</string>
    <string name="byedpi_ports">ByeDPI TCP ports</string>
    <string name="fake_sni">SNI for fake packets ({sni})</string>
    <string name="ports_hint">Comma separated, ranges as 50000-50100. Store presets use their own ports.</string>
    <string name="settings_check">Background check</string>
    <string name="check_hint">Manka periodically restarts crashed services and checks that the sites still open. The check is a few HTTPS requests, it costs almost no battery.</string>
    <string name="auto_reselect">Re-select automatically</string>
    <string name="auto_reselect_hint">If the strategy stops working, run a quick selection and apply the best result</string>
    <string name="request_timeout">Request timeout: %1$ds</string>
    <string name="settings_module">Module</string>
    <string name="module_info">Module: %1$s\nconnbytes: %2$s  multiport: %3$s  NFQUEUE: %4$s</string>
    <string name="no_connbytes_hint">The kernel has no connbytes match (typical for GKI). Manka passes only SYN and data packets to zapret, not the empty ACKs, so the load stays small but a bit higher than with connbytes. ByeDPI is not affected.</string>
